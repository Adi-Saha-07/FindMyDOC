# FindMyDOC Environment Configuration
# ==================================

# Choose database backend: 'memory' (default) or 'mongodb'
DATA_BACKEND=mongodb

# Option 1: Local MongoDB Community Server
# MONGO_URI=mongodb://localhost:27017/findmydoc

# Option 2: Cloud MongoDB Atlas (Free Cloud Database)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/findmydoc?retryWrites=true&w=majority

DATABASE_NAME=findmydoc
SECRET_KEY=findmydoc-production-secret-key-2026
FLASK_ENV=development
